{
    "compilerOptions": {
      "rootDir": "./src",
      "outDir": "./dist",
      "module": "NodeNext",
      "target": "es2022",
      "lib": ["es2022"],
      "types": ["node"],
      "moduleResolution": "NodeNext",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "sourceMap": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"]
  }